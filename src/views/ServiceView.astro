---
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizedPath } from "../il8n/utils";
import type { Lang } from "../il8n/ui";

interface Props {lang: Lang}
const {lang} = Astro.props;

const copy = {
    en: {
        title: 'Our Services',
        hero: 'Expertise build for modern business.',
        sub: 'Three focused disciplines. One integrated team dedicated to your growth.',
        processTitle: 'How we work',
        steps: ['Discovery', 'Strategy', 'Execution', 'Optimization'],
    },
    es: {
        title: 'Servicios',
        hero: 'Experiencia construida para negocios modernos.',
        sub: 'Tres disciplinas enfocadas. Un solo equipo integrado dedicado a tu crecimiento.',
        processTitle: 'Como trabajamos',
        steps: ['Descubrimiento', 'Estrategia', 'Ejecucion', 'Optimizacion'],
    }
}[lang];

const services = [
    {slug: 'web-development', title: lang === 'es' ? 'Desarrollo Web' : 'Web Development', desc: lang === 'es' ? 'Sitios ultrarrapidos y accesibles usando tecnologias modernas como Astro y React.' : 'Ultra-fast, accessible websites usinf modern technologies like Astro and React.'},
    {slug: 'digital-marketing', title: lang === 'es' ? 'Marketing Digital' : 'Digital Marketing', desc: lang === 'es' ? 'Campanas basadas en datos que convierten el presupuesto en clientes reales.' : 'Data-driven campaigns that turn budget into real customers.'},
    {slug: 'seo', title: 'SEO', desc: lang === 'es' ? 'Visibilidad organica sostenible que se compone mes tras mes.' : 'Sustainable organic visibility that compounds month over month.'},    
];
---

<BaseLayout lang={lang} title={copy.title}>
    <section class="border-b border-line">
        <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
            <h1 class="max-w-3xl font-display text-4xl font-semibold tracking-tight md:text-5xl">{copy.hero}</h1>
            <p class="mt-6 max-w-2xl text-lg text-muted leading-relaxed">{copy.sub}</p>            
        </div>
    </section>
    <section class="border-b border-line">
        <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
            <div class="grid gap-6 md:grid-cols-3">
                {services.map((s, i) => (
                    <a href={localizedPath(`/services/${s.slug}`, lang)} class="group flex flex-col rounded-card border border-line bg-surface p-8 transition-all hover:border-accent hover:shadow-sm">
                        <span class="text-xs font-medium text-muted">0{i + 1}</span>
                        <h3 class="mt-4 font-display text-xl font-semibold group-hover:text-accent transition-colors">{s.title}</h3>
                        <p class="mt-3 grow text-sm text-muted leading-relaxed">{s.desc}</p>
                        <div class="mt-8 text-sm font-medium text-accent flex items-center gap-2">
                            {lang === 'es' ? 'Ver detalles' : 'View details'}
                            <span class="transition-transform group-hover:translate-x-1">→</span>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>
    <section>
        <div class="mx-auto max-w-6xl px-6 py-20 md:py-20 text-center">
            <h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl mb-12">{copy.processTitle}</h2>
            <div class="flex flex-col md:flex-row justify-center items-center gap-6 md:gap-12">
                {copy.steps.map((step,i) => (
                    <div class="flex items-center gap-4">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent text-accent-fg text-sm font-bold">
                            {i + 1}
                        </div>
                        <span class="font-medium">{step}</span>
                        {i < copy.steps.length - 1 && <span class="hidden md:block text-line">→</span>}
                    </div>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>