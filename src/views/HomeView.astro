const services = [
  {
    slug: "web-development",
    title: lang === "es" ? "Desarrollo Web" : "Web Development",
    desc:
      lang === "es"
        ? "Sitios rapidos, accesibles y faciles de mantener."
        : "Fast, accessible websites built to last.",
  },
  {
    slug: "digital-marketing",
    title: lang === "es" ? "Marketing Digital" : "Digital Marketing",
    desc:
      lang === "es"
        ? "Campanas que convierten presupuesto en clientes."
        : "Campaigns that turn budget into customers.",
  },
  {
    slug: "seo",
    title: "SEO",
    desc:
      lang === "es"
        ? "Visibilidad organica que crece cada mes."
        : "Organic visibility that grows month over month.",
  },
  {
    slug: "ui-ux-design",
    title: "UI/UX Design",
    desc:
      lang === "es"
        ? "Interfaces intuitivas que deleitan a los usuarios e impulsan las conversiones."
        : "Intuitive interfaces that delight users and drive conversions.",
