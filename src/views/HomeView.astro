---

<BaseLayout lang={lang} title="DigiComp" description={copy.sub}>
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 md:py-32">
      <h1
        class="max-w-3xl font-display text-4xl font-semibold leading-[1.1] tracking-tight md:text-6xl"
      >
        {copy.h1}
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
        {copy.sub}
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href={localizedPath("/contact", lang)}
          class="rounded-btn bg-accent px-4 sm:px-6 py-3 text-center text-sm font-medium text-accent-fg transition-opacity hover:opacity-90"
        >
          {copy.ctaPrimary}
        </a>
        <a
          href={localizedPath("/services", lang)}
          class="rounded-btn border border-line px-4 sm:px-6 py-3 text-center text-sm font-medium transition-colors hover:bg-surface"
        >
          {copy.ctaSecondary}
        </a>
      </div>
    </div>
  </section>
  <section class="border-b border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-8 divide-y md:divide-y-0 md:divide-x divide-line text-center"
      >
        <div class="pt-4 md:pt-0">
          <p class="font-display text-4xl font-bold text-fg">150+</p>
          <p class="mt-2 text-sm font-medium text-muted">{copy.stat1}</p>
        </div>
        <div class="pt-4 md:pt-0">
          <p class="font-display text-4xl font-bold text-accent">+180</p>
          <p class="mt-2 text-sm font-medium text-muted">{copy.stat2}</p>
        </div>
        <div class="pt-4 md:pt-0">
          <p class="font-display text-4xl font-bold text-fg">95%</p>
          <p class="mt2 text-sm font-medium text-muted">{copy.stat3}</p>
        </div>
      </div>
    </div>
  </section>
  <section class="border-b border-line">
    <div class="mx-auto px-4 max-w-6xl sm:px-6 py-20 md:py-28">
      <div class="max-w-2xl">
        <h2
          class="font-display text-3xl font-semibold tracking-tight md:text-4xl"
        >
          {copy.servicesTitle}
        </h2>
        <p class="mt-4 text-lg text-muted">
          {copy.servicesSub}
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
        {
          services.map((s, i) => (
            <a
              href={localizedPath(`/services/${s.slug}`, lang)}
              class="group flex flex-col rounded-card border border-line bg-surface p-8 transition-all hover:shadow-sm hover:border-accent"
            >
              <h3 class="font-display text-xl font-semibold">{s.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
                {s.desc}
              </p>
              <span class="mt-6 inline-flex items-center text-sm font-medium text-accent">
                {t("common.readMore")}
                <svg
                  class="ml-1 w-4 h-4 transition-transform group-hover:translate-x-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="border-b border-line bg-surface/30">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-20 md:py-28">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2
          class="font-display text-3xl font-semibold tracking-tight md:text-4xl"
        >
          {copy.processTitle}
        </h2>
        <p class="mt-4 text-lg text-muted">{copy.processSub}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-3 relative">
        <div
          class="hidden md:block absolute top-8 left-[16%] right-[16%] h-px bg-line -z-10"
        >
        </div>
        <div class="relative text-center">
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-line bg-bg text-xl font-bold font-display text-accent mb-6 hover:bg-accent hover:text-accent-fg transition-colors"
          >
            1
          </div>
          <h3 class="font-display text-lg font-semibold">{copy.step1Title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed px-4">
            {copy.step1Desc}
          </p>
        </div>
        <div class="relative text-center">
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-line bg-bg text-xl font-bold font-display text-accent mb-6 hover:bg-accent hover:text-accent-fg transition-colors"
          >
            2
          </div>
          <h3 class="font-display text-lg font-semibold">{copy.step2Title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed px-4">
            {copy.step2Desc}
          </p>
        </div>
        <div class="relative text-center">
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-line bg-bg text-xl font-bold font-display text-accent mb-6 hover:bg-accent hover:text-accent-fg transition-colors"
          >
            3
          </div>
          <h3 class="font-display text-lg font-semibold">{copy.step3Title}</h3>
          <p class="mt-3 text-sm text-muted leading-relaxed px-4">
            {copy.step3Desc}
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="border-b border-line overflow-hidden">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 py-20 md:py-28 relative">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2
          class="font-display text-3xl font-semibold tracking-tight md:text-4xl"
        >
          {copy.testiTitle}
        </h2>
        <p class="mt-4 text-lg text-muted">{copy.testiSub}</p>
      </div>
      <div id="testi-container" class="relative group max-w-3xl mx-auto">
        <button id="prev-testi" class="absolute left-[-4rem] top-1/2 -translate-y-1/2 z-10 hidden md:flex h-10 w-10 items-center justify-center rounded-full border border-line bg-bg shadow-sm text-muted hover:text-fg hover:border-accent transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div
          id="testi-track"
          class="flex w-full overflow-x-auto snap-x snap-mandatory scroll-smooth pb-8 [&::-webkit-scrollbar]:hidden [-ms-ovrflow-style: 'none'] [scrollbar-width: 'none']"
        >
          {
            testimonials.map((testi) => (
              <div class="snap-center shrink-0 w-full px-2 sm:px-4">
                <div class="flex flex-col p-8 md:p-12 rounded-card border border-line bg-surface relative h-full shadow-sm">
                  <svg
                    class="w-10 h-10 text-accent/20 mb-6"
                    fill="currentColor"
                    viewBox="0 0 32 32"
                    aria-hidden="true"
                  >
                    <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
                  </svg>
                  <blockquote class="font-display text-xl md:text-2xl font-medium leading-relaxed flex-1">
                    {testi.quote}
                  </blockquote>
                  <div class="mt-8 flex items-center justify-center gap-3 border-t border-line pt-6">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-accent/10 text-accent font-bold text-lg">
                      {testi.initial}
                    </div>
                    <div class="text-left">
                      <div class="text-sm font-semibold">{testi.author}</div>
                      <div class="text-xs text-muted">{testi.role}</div>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <button id="next-testi" class="absolute right-[-4rem] top-1/2 -translate-y-1/2 z-10 hidden md:flex h-10 w-10 items-center justify-center rounded-full border border-line bg-bg shadow-sm text-muted hover:text-fg hover:border-accent transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="flex justify-center gap-2 mt-4" id="testi-dots"></div>
      </div>
    </div>
  </section>
  <section>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-20 md:py-28">
      <div
        class="rounded-card border border-line bg-surface p-10 text-center md:p-16 relative overflow-hidden"
      >
        <div
          class="absolute inset-0 bg-linear-to-br from-accent/5 to-transparent"
        >
        </div>
        <div class="relative z-10">
          <h2
            class="font-display text-3xl font-semibold tracking-tight md:text-4xl"
          >
            {lang === "es" ? "Listo para crecer?" : "Ready to grow?"}
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
            {
              lang === "es"
                ? "Cuentanos sobre tu proyecto y te responderemos en menos de 24 horas."
                : "Tell us about your project and we will get back to you within 24 hours."
            }
          </p>
          <a
            href={localizedPath("/contact", lang)}
            class="mt-8 inline-block rounded-btn bg-accent px-8 py-3.5 text-sm sm:px-6 font-medium text-accent-fg transition-opacity hover:opacity-90"
          >
            {t("nav.cta")}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<script is:inline>
  const initTestiCarousel = () => {
    const track = document.getElementById('testi-track');
    const container = document.getElementById('testi-container');
    const dotsContainer = document.getElementById('testi-dots');
    const prevBtn = document.getElementById('prev-testi');
    const nextBtn = document.getElementById('next-testi');

    if(!track || !container || !dotsContainer || !prevBtn || !nextBtn) return;

    if (window.testiInterval) clearInterval(window.testiInterval);
    
    const totalSlides = track.children.length;
    let currentIndex = 0;
    let isAutoScrolling = false;

    dotsContainer.innerHTML = '';
    for (let i = 0; i < totalSlides; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = `h-2 rounded-full transition-all duration-300 ${i === 0 ? 'w-6 bg-accent' : 'w-2 bg-line hover:bg-accent/50'}`;
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
        dot.onclick = () => {
            goToSlide(i);
            resetInterval();
        };
        dotsContainer.appendChild(dot);
    }

    const syncDots = (index) => {
        Array.from(dotsContainer.children).forEach((dot, i) => {
            if (i === index) {
                dot.classList.add('w-6', 'bg-accent');
                dot.classList.remove('w-2', 'bg-line');
            }else {
                dot.classList.remove('w-6', 'bg-accent');
                dot.classList.add('w-2', 'bg-line');
            }
        });
    };

    const goToSlide = (index) => {
        currentIndex = index;
        isAutoScrolling = index;
        track.scrollTo({left: track.clientWidth * currentIndex, behavior: 'smooth'});
        syncDots(currentIndex);
        setTimeout(() => {isAutoScrolling = false;}, 500);
    };

    let scrollTimeout;
    track.addEventListener('scroll', () => {
        if (isAutoScrolling) return;
        stopAutoScroll();
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout (() => {
            const index = Math.round(track.scrollLeft / track.clientWidth);
            if (index !== currentIndex && index >= 0 && index < totalSlides) {
                currentIndex = index;
                syncDots(currentIndex);
            }
            resetInterval();
        }, 150);
    }, {passive: true});

    prevBtn.onclick = () => {
        currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        goToSlide(currentIndex);
        resetInterval();
    };

    nextBtn.onclick = () => {
        currentIndex = (currentIndex + 1) % totalSlides;
        goToSlide(currentIndex);
        resetInterval();
    };

    const startAutoScroll = () => {
        stopAutoScroll();
        window.testiInterval = setInterval(() => {
            currentIndex = (currentIndex + 1) % totalSlides;
            goToSlide(currentIndex);
        }, 5000);
    };

    const stopAutoScroll = () => {
      if (window.testiInterval){
        clearInterval(window.testiInterval);
        window.testiInterval = null;
      }
    };

    const resetInterval = () => {
      stopAutoScroll();
      startAutoScroll();
    };

    container.onmouseenter = stopAutoScroll;
    container.onmouseleave = startAutoScroll;

    container.ontouchstart = stopAutoScroll;
    container.ontouchend = resetInterval;
   

    setTimeout(startAutoScroll, 500);
  };
  initTestiCarousel();
  document.addEventListener("astro:page-load", initTestiCarousel);
</script>
