const testimonials = {
  en: [
    {
      quote:
        '"DigiComp completely transformed our digital presence. Our organic traffic tripled in just six months, and the quality leads is unmatched"',
      author: "Jeanice Doe",
      role: "CMO at TechFlow",
      initial: "J",
    },
    {
      quote:
        '"The team is incredibly responsive and the code they deliver is clean and fast. Our site loads instantly now. Highly recommended!"',
      author: "Catherine",
      role: "Founder at StartupX",
      initial: "C",
    },
    {
      quote:
        '"Our conversion rates increased by 40% after the redesign. Their data-driven approach to marketing really works."',
      author: "Mark Smith",
      role: "Marketing Director at FinServe",
      initial: "M",
    },
    {
      quote:
        '"Professional, transparent, and results-oriented. Easily the best digital agency we have worked with so far."',
      author: "David Chen",
      role: "CEO de InnovateLab",
      initial: "D",
    },
  ],
  es: [
    {
      quote:
        '"DigiComp transformo completamente nusetra presencia digital. Nuestro trafico organico se triplico en solo seis meses."',
      author: "Jeanice Doe",
