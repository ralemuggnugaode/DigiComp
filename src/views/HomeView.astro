    ctaSecondary: "Explore services",
    statsTitle: "Trusted by ambitious brands",
    stat1: "Project Delivered",
    stat2: "Avg. Organic Growth",
    stat3: "Client Retention",
    servicesTitle: "What we do",
    servicesSub: "Thress focused disciplined, one integrated team.",
    processTitle: "How we work",
    processSub:
      "A Systematic approach to turning your digital presence into a revenue driver.",
    step1Title: "Discover & Strategy",
    step1Desc:
      "We analyze your market, competitors, and current performance to build a custom roadmap.",
    step2Title: "Build & Execute",
    step2Desc:
      "Our team executes with clean code, data-driven campaigns, and technial precision.",
    step3Title: "Scale & Optimize",
