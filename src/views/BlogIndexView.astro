---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/blog/PostCard.astro";
import { getPosts } from "../lib/content";
import type { Lang } from "../il8n/ui";

interface Props {lang: Lang}
const {lang} = Astro.props;
const posts = await getPosts(lang);

const copy = {
    en: { title: 'Insights & Articles', sub: 'Thoughts on web development, marketing, and search engine optimization.' },
    es: { title: 'Articulos e Ideas', sub: 'Pensamientos sobre desarrollo web, marketing y optimizacion de motores de busqueda.' }
}[lang];
---

<BaseLayout lang={lang} title={copy.title}>
<section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <h1 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">{copy.title}</h1>
        <p class="mt-4 max-w-2xl text-lg text-muted">{copy.sub}</p>

        <div class="mt-10 max-w-md">
            <div id="search"></div>
        </div>
    </div>
</section>
<section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    {posts.length === 0 ? (
        <p class="text-muted">No posts found.</p>
    ): (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map(post => <PostCard post={post} lang={lang} />)}
        </div>
    )}
</section>
</BaseLayout>
<script is:inline>
import { startsWith } from "astro:schema";
import { languages } from "../il8n/ui";

    function initPagefind() {
        const searchEl = document.getElementById('search');
        if (searchEl && typeof PagefindUI !== 'undefined') {
            searchEl.innerHTML = '';
            const currentLang = document.documentElement.Lang || 'en';
            const isSpanish = currentLang.startsWith('es');
            new PagefindUI ({
                element: '#search',
                showSubResults: true,
                languages: currentLang,
                translations: {
                    placeholder: isSpanish ? "Buscar articulos..." : "Search articles...",
                    zero_results: isSpanish ? "No se encontraron para [SEARCH_TERM]" : "No results for [SEARCH_TERM]",
                }
            });
        } else if (searchEl) {
            setTimeout(initPagefind, 100);
        }
    }

    initPagefind();

    document.addEventListener('astro:page-load', initPagefind);
</script>