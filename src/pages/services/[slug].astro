---
import ServiceDetailView from "../../views/ServiceDetailView.astro";

export function getStaticPaths() {
    return [
        {params: {slug: 'web-development'}},
        {params: {slug: 'digital-marketing'}},
        {params: {slug: 'seo'}},
        {params: {slug: 'ui-ux-design'}},
    ];
}

const {slug} = Astro.params;
---

<ServiceDetailView lang="en" slug={slug as string} />