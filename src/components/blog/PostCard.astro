---
import type { Post } from "../../lib/mock/posts";
import { localizedPath } from "../../il8n/utils";
import type { Lang } from "../../il8n/ui";

interface Props {post: Post; lang: Lang}
const {post, lang} = Astro.props;
---

<a href={localizedPath(`/blog/${post.slug}`, lang)} class="group flex flex-col h-full rounded-card border border-line bg-surface overflow-hidden transition-colors hover:border-accent">
{post.cover && (
    <div class="aspect-[16/9] w-full overflow-hidden border-b border-line bg-line">
        <img src={post.cover} alt={post.title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
    </div>
)}
<div class="flex flex-col grow p-6">
    <div class="flex items-center gap-2 text-xs font-medium text-accent mb-3">
        <span>{post.category.name}</span>
    </div>
    <h3 class="font-display text-xl font-semibold leading-tight group-hover:text-accent transition-colors">{post.title}</h3>
    <p class="mt-3 text-sm text-muted grow leading-relaxed line-clamp-3">{post.excerpt}</p>
    <div class="mt-6 flex items-center justify-between border-t border-line pt-4">        
        <span class="text-xs text-muted">{post.author.name}</span>
        <span class="text-xs text-muted">{post.readingMinutes}</span>
    </div>
</div>
</a>