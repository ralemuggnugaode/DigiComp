---
import Logo from '../brand/logo.astro';
import '../../styles/header.css'
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import {NAV, SITE} from '../../consts';
import { useTranslations, localizedPath } from '../../il8n/utils';
import type { Lang } from '../../il8n/ui';

interface Props {lang: Lang}
const { lang } = Astro.props;
const t = useTranslations(lang);
const current = Astro.url.pathname;
---

<div id="scroll-sentinel" class="absolute top-0 h-10 w-full pointer-events-none -z-10"></div>

<header id="main-header" class="sticky top-0 z-40 w-full transition-all duration-500 ease-in-out">
    <div id="navbar-container" class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 transition-all duration-500 ease-in-out">        
        <a href={localizedPath('/', lang)} aria-label={SITE.name} class="shrink-0">
            <Logo />
        </a>

        <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
            {NAV.map((item) => {
                const href = localizedPath(item.href, lang);
                const active = current === href || (item.href !== '/' && current.startsWith(href));
                return (
                    <a href={href}
                        aria-current = {active ? 'page' : undefined}
                        class:list = {[
                            'text-sm transition-colors hover:text-fg',
                            active ? 'text-fg font-medium' : 'text-muted',
                        ]}
                        >{t(item.key)}
                    </a>
                );
            })}
        </nav>

        <div class="flex items-center gap-3">
            <LangSwitcher lang={lang} />
            <ThemeToggle label={t('theme.toggle')} />
            <a href={localizedPath('/contact', lang)}
            class="hidden rounded-btn bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90 md:inline-block">
            {t('nav.cta')}
            </a>

            <button id="menu-open"
            class="inline-flex h-9 w-9 items-center justify-center rounded-btn border border-line md:hidden hover:bg-surface"
            aria-label = "Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
                </svg>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="hidden absolute top-16 left-0 w-full border-b border-line bg-bg shadow-lg md:hidden">
        <nav class="flex flex-col px-4 py-4 space-y-2" aria-label="Mobile">
            {NAV.map((item) => (
                <a href={localizedPath(item.href, lang)} 
                class="rounded-btn px-3 py-2.5 text-sm font-medium text-muted hover:bg-surface hover:text-fg transition-colors"
                >{t(item.key)}
                </a>
            ))}
            <a href={localizedPath('/contact', lang)}
            class="block w-full rounded-btn bg-accent px-4 py-2.5 text-center text-sm font-medium text-accent-fg"
            >{t('nav.cta')}
            </a>
        </nav>
    </div>
</header>

<script>
    const intMobileMenu = () => {
        const btn = document.getElementById('menu-open');
        const menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        (btn as HTMLButtonElement).onclick = () => {
            const isHidden = menu.classList.contains('hidden');
            if (isHidden) {
                menu.classList.remove('hidden');
                btn.setAttribute('aria-expanded', 'true');
            } else {
                menu.classList.add('hidden');
                btn.setAttribute('aria-expanded', 'false');
            }
        };
    };

    intMobileMenu();

    document.addEventListener('astro:page-load', intMobileMenu);
</script>
<script>
    import { initHeader } from "../../scripts/header";
    initHeader();
    document.addEventListener('astro:page-load', initHeader);
</script>