---
import Logo from '../brand/logo.astro';
import '../../styles/header.css'
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import {NAV, SITE} from '../../consts';
import { useTranslations, localizedPath } from '../../il8n/utils';
import type { Lang } from '../../il8n/ui';

interface Props {lang: Lang}
const { lang } = Astro.props;
const t = useTranslations(lang);
const current = Astro.url.pathname;
---

<div id="scroll-sentinel" class="absolute top-0 h-10 w-full pointer-events-none -z-10"></div>

<header id="main-header" class="sticky top-0 z-40 w-full transition-all duration-500 ease-in-out">
    <div id="navbar-container" class=" mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 transition-all duration-500 ease-in-out backdrop-blur-md">
        <a href={localizedPath('/', lang)} aria-label={SITE.name} class="shrink-0">
            <Logo />
        </a>
        
            <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
                {NAV.map((item) => {
                    const href = localizedPath(item.href, lang);
                    const active = current === href || (item.href !== '/' && current.startsWith(href));
                    return (
                        <a href={href}
                            aria-current = {active ? 'page' : undefined}
                            class:list = {[
                                'text-sm transition-colors hover:text-fg',
                                active ? 'text-fg font-medium' : 'text-muted',
                            ]}
                            >{t(item.key)}
                        </a>
                    );
                })}
            </nav>


        <div class="flex items-center gap-3">
            <LangSwitcher lang={lang} />
            <ThemeToggle label={t('theme.toggle')} />
            <a href={localizedPath('/contact', lang)}
            class="hidden rounded-btn bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90 md:inline-block">
            {t('nav.cta')}
            </a>

            <button id="menu-open" type="button"
            class="inline-flex h-9 w-9 items-center justify-center rounded-btn border border-line md:hidden hover:bg-surface transition-colors"
            aria-label="Toggle menu"
            aria-expanded="false"
            >
                <svg id="icon-hamburger" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
                </svg>
                <svg id="icon-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="hidden absolute top-[calc(100%+8px)] left-0 w-full px-4 pt-2 md:hidden">
        <div class="rounded-2xl border border-line bg-bg/95 shadow-2xl p-4 flex flex-col space-y-1 backdrop-blur-xl">
                {NAV.map((item) => {
                    const href = localizedPath(item.href, lang);
                    const active = current === href || (item.href !== '/' && current.startsWith(href));
                    return (
                    <a href={href} 
                    class:list={["rounded-xl px-4 py-3 text-base font-medium transition-colors ", active ? "bg-surface text-accent bg-linear-to-l from-accent/5 to-transparent" : "text-muted hover:bg-surface hover:text-fg"]}
                    >{t(item.key)}
                    </a>
                    )
                })}
                <div class="pt-4 mt-2 border-t border-line">
                <a href={localizedPath('/contact', lang)}
                class="flex w-full items-center justify-center rounded-xl bg-accent px-4 py-3 text-center text-base font-medium text-accent-fg transition-opacity hover:opacity-90"
                >
                    {t('nav.cta')}
                </a>
            </div>
        </div>
    </div>
</header>

<script is:inline>
    const initMobileMenu = () => {
        const btn = document.getElementById('menu-open');
        const menu = document.getElementById('mobile-menu');
        const iconHamburger = document.getElementById('icon-hamburger');
        const iconClose = document.getElementById('icon-close');

        if (!btn || !menu || !iconHamburger || !iconClose) return;

        btn.onclick = () => {
            menu.classList.toggle('hidden');
            const isOpen = !menu.classList.contains('hidden');
            if (isOpen) {
                iconHamburger.classList.add('hidden');
                iconClose.classList.remove('hidden');
                btn.setAttribute('aria-expanded', 'true');
            }else {
                iconHamburger.classList.remove('hidden');
                iconClose.classList.remove('hidden');
                btn.setAttribute('aria-expanded', 'false')
            }
        }

        menu.querySelectorAll('a').forEach(link => {
            link.onclick = () => {
                menu.classList.add('hidden');
                iconHamburger.classList.remove('hidden');
                iconClose.classList.add('hidden');
                btn.setAttribute('aria-expanded', 'false');
            }
        });
    };

    initMobileMenu();
    document.addEventListener('astro:page-load', initMobileMenu);
</script>
<script>
    import { initHeader } from "../../scripts/header";
    initHeader();
    document.addEventListener('astro:page-load', initHeader);
</script>