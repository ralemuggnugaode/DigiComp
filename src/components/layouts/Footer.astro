---
import { SITE, NAV } from "../../consts";
import { useTranslations, localizedPath } from "../../il8n/utils";
import type { Lang } from "../../il8n/ui";
import Logo from "../brand/logo.astro";

interface Props {lang: Lang}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 md:py-16">
        <div class="grid gap-10 md:grid-cols-4 lg:gap-8">
            <div class="md:col-span-2">
                <a href={localizedPath('/', lang)} aria-label={SITE.name} class="inline-block mb-4">
                <Logo />
                </a>
                <p class="text-sm text-muted max-w-xs leading-relaxed">
                    {lang === 'es' 
                    ? 'Convertimos tu presencia digital en un motor de crecimiento medible.'
                    : 'Turning your digital presence into a measurable growtch engine.'
                    }
                </p>
            </div>
            <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">
                    Menu
                </h3>
                <ul class="space-y-3">
                    {NAV.map((item) => (
                        <li>
                            <a href={localizedPath(item.href, lang)} class="text-sm text-muted hover:text-accent transition-colors">
                                {t(item.key)}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
            <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Found Us</h3>
                <ul class="space-y-3">
                    <li><a href={`mailto:${SITE.email}`} class="text-sm text-muted hover:text-accent transition-colors">{SITE.email}</a></li>
                    <li><a href={SITE.socials.instagram} target="_blank" rel="noreferrer" class="text-sm text-muted hover:text-accent transition-colors">Instagram</a></li>
                </ul>
            </div>
        </div>
        <div class="mt-12 pt-8 border-t border-line flex flex-col md:flex-row items-center justify-between gap-4">
            <p class="text-xs text-muted">© {year} {SITE.name}. All rights reserved.</p>
            <p class="text-xs text-muted">Built with Astro & React.</p>
        </div>
    </div>
</footer>